# MedImage Agent environment example

MEDIMAGE_ENV=local_dev

# Backend
MEDIMAGE_BACKEND_HOST=127.0.0.1
MEDIMAGE_BACKEND_PORT=8000
MEDIMAGE_API_BASE_URL=http://127.0.0.1:8000
# Optional deterministic dashboard fixtures for demos/tests only.
# Real desktop sessions start with an empty project/task store by default.
MEDIMAGE_DESKTOP_SEED_DEMO_DATA=false

# Frontend
MEDIMAGE_FRONTEND_HOST=127.0.0.1
MEDIMAGE_FRONTEND_PORT=5173
VITE_API_BASE_URL=http://127.0.0.1:8000

# Runtime directories
MEDIMAGE_WORK_DIR=./work
MEDIMAGE_REPORT_DIR=./reports
MEDIMAGE_LOG_DIR=./logs
MEDIMAGE_DERIVATIVES_DIR=./derivatives

# Optional LLM planner/advisor layer
# The planner works in deterministic fallback mode when this is disabled.
MEDIMAGE_LLM_ENABLED=false
MEDIMAGE_LLM_PROVIDER=openai
MEDIMAGE_LLM_API_KEY=
MEDIMAGE_LLM_MODEL=
MEDIMAGE_LLM_BASE_URL=https://api.openai.com/v1
MEDIMAGE_LLM_TIMEOUT_SECONDS=30

# Optional bounded, advice-only Agent Harness. It never approves or executes.
MEDIMAGE_AGENT_HARNESS_ENABLED=false
MEDIMAGE_AGENT_HARNESS_MAX_STEPS=8
MEDIMAGE_AGENT_HARNESS_MAX_MODEL_CALLS=6
MEDIMAGE_AGENT_HARNESS_MAX_ACTION_PROPOSALS=8
MEDIMAGE_AGENT_HARNESS_MAX_REPAIRS=1
MEDIMAGE_AGENT_HARNESS_MAX_RECOVERY_ATTEMPTS=2
MEDIMAGE_AGENT_HARNESS_MAX_WALL_SECONDS=300
# Token limits are optional and remain disabled unless the provider reliably reports usage.
MEDIMAGE_AGENT_HARNESS_MAX_INPUT_TOKENS=
MEDIMAGE_AGENT_HARNESS_MAX_OUTPUT_TOKENS=
MEDIMAGE_AGENT_HARNESS_LEASE_SECONDS=30
MEDIMAGE_AGENT_HARNESS_MAX_STEPS_PER_WAKEUP=3

# Project-scoped long-term memory (all installation gates default closed)
MEDIMAGE_MEMORY_ENABLED=false
MEDIMAGE_MEMORY_GENERATION_ENABLED=false
MEDIMAGE_MEMORY_USE_ENABLED=false
MEDIMAGE_MEMORY_LLM_EXTRACTION_ENABLED=false
MEDIMAGE_MEMORY_LLM_CONSOLIDATION_ENABLED=false
MEDIMAGE_MEMORY_PROJECTION_ENABLED=false
# Defaults beside MEDIMAGE_DESKTOP_STORE_PATH when omitted.
MEDIMAGE_MEMORY_STORE_PATH=./outputs/work/desktop/memory_state.sqlite
MEDIMAGE_MEMORY_MAX_CONTEXT_BYTES=16384
MEDIMAGE_MEMORY_CANDIDATE_RETENTION_DAYS=30
MEDIMAGE_MEMORY_ITEM_RETENTION_DAYS=180

# MATLAB / SPM / DPABI external dependencies
# In docker_demo these should remain disabled unless explicitly configured.
MEDIMAGE_MATLAB_ENABLED=false
MEDIMAGE_MATLAB_COMMAND=matlab
MEDIMAGE_SPM_DIR=./third_party/spm12
MEDIMAGE_DPABI_DIR=./third_party/DPABI_V8.2_240510

# Safety defaults
MEDIMAGE_ENABLE_REVIEWED_EXECUTION=0
MEDIMAGE_ALLOW_FULL_DPABI_EXECUTION=false
MEDIMAGE_ALLOW_DPARSF_RUN=false
MEDIMAGE_ALLOW_DPARSFA_RUN=false
MEDIMAGE_ALLOW_RAWDATA_WRITE=false
MEDIMAGE_SYNTHETIC_ONLY=true

# Agent Task approvals are fail-closed. Electron injects fresh per-launch values;
# standalone deployments must source both values from a secret manager, never Git.
MEDIMAGE_AGENT_APPROVAL_TOKEN=
MEDIMAGE_AGENT_APPROVAL_ACTOR=
